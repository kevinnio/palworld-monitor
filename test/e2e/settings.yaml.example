# ============================================================================
# E2E test settings — copy to settings.yaml and adjust exePath
# ============================================================================
palserver:
  # Path to the Palworld server executable (required — update for your system)
  exePath: "C:\\Program Files (x86)\\Steam\\steamapps\\common\\PalServer\\PalServer.exe"
  host: "127.0.0.1"
  port: 8211
  adminPassword: "palworld123"
  restPort: 8212
  rconPort: 25575

# ============================================================================
# Web — uses a non-default port (8213) and known creds so tests can log in
# ============================================================================
web:
  enabled: true
  port: 8213
  username: "admin"
  password: "admin"
  controlServer: true
  showServerIP: false

# ============================================================================
# Features — autoStart/autoStop off so the test controls lifecycle manually
# ============================================================================
features:
  playerTracking: true
  autoStart: false
  autoStop: false

autoStop:
  stopDelay: 600

security:
  sessionSecretKey: null
  sessionTimeout: 3600
  maxLoginAttempts: 5
  lockoutDuration: 300
  rateLimitEnabled: true
  rateLimitRequests: 100
  rateLimitWindow: 60
