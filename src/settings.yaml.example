# ============================================================================
# Palworld Server Configuration
# ============================================================================
palserver:
  # Path to the Palworld server executable (required).
  # If useLGSM is true, this must instead be the path to your LGSM instance
  # script, e.g. "/home/gameserver/pwserver/pwserver".
  exePath: "C:\\Program Files (x86)\\Steam\\steamapps\\common\\PalServer\\PalServer.exe"
  # IP address for the Palworld server
  host: "127.0.0.1"
  # Port for the Palworld server. The monitor will listen on this port for players
  # attempting to connect.
  port: 8211
  # Admin password for the Palworld server (required) — change this on first use
  adminPassword: "changeme"
  # Set to true on Linux if PalServer is managed by LinuxGSM (LGSM). Instead of
  # launching/killing PalServer directly, the monitor will run the LGSM script's
  # own `start`/`stop` commands (exePath above must point at that script), so
  # LGSM's own state tracking and `monitor` cron job stay in sync.
  useLGSM: false
  # Protocol used for server communication
  protocol: "REST"
  # Port for the REST API
  restPort: 8212
  # How often to reach out to the Palworld server for status and player
  # data (seconds)
  pollingRate: 5

# ============================================================================
# Web Server Configuration
# ============================================================================
web:
  # Whether to enable the web server
  enabled: true
  # Port for the web server
  port: 8213
  # Web interface username
  username: "admin"
  # Web interface password (required) — change this on first use
  password: "changeme"
  # Enable server control through web interface (combines all button controls)
  controlServer: true
  # Show server IP address in UI
  showServerIP: false

# ============================================================================
# Feature flags
# ============================================================================
features:
  playerTracking: true
  autoStart: true
  autoStop: true

# ============================================================================
# Auto Stop settings
# ============================================================================
autoStop:
  # Seconds before auto-stopping the server
  stopDelay: 600

# ============================================================================
# Security & Rate Limiting
# ============================================================================
security:
  # Secret key for session encryption (auto-generated if not provided)
  sessionSecretKey: null
  # Session timeout in seconds (default: 1 hour)
  sessionTimeout: 3600
  # Maximum failed login attempts before lockout
  maxLoginAttempts: 5
  # Lockout duration in seconds after max failed attempts (default: 5 minutes)
  lockoutDuration: 300
  # Enable rate limiting for requests
  rateLimitEnabled: true
  # Maximum requests per window
  rateLimitRequests: 100
  # Rate limit window in seconds
  rateLimitWindow: 60

# ============================================================================
# Logging
# ============================================================================
# The defaults keep an unattended run bounded: the active log file is capped,
# rotated backups are gzipped, and both their count and age are limited. The
# log file is appended to, never truncated, so history survives restarts.
logging:
  # Folder for log files (palworld-monitor.log plus palworld-monitor.log.1.gz,
  # .2.gz, ...).
  # Default: a "logs" folder inside the app folder — the folder holding the exe
  # in a release, the project root when running from source, moved by --app-dir
  # or PALWORLD_MONITOR_APP_DIR. The app folder is not a setting: it is where
  # this file itself is found, unless --settings points somewhere else.
  dir: null
  # Size of one log file before it is rotated: bytes, or a size like "5 MB",
  # "500 KB", "1.5 GB" ("5_000_000" and a plain byte count also work).
  # Anything below 1 KB is rejected: it would rotate on almost every line.
  maxSize: "5 MB"
  # Number of rotated files to keep (0-1000). Set to 0 to keep only the active
  # file: it starts over at maxSize and the older history is dropped.
  backupCount: 10
  # Rotate the log file by size (true or false). With false the file grows
  # without a cap, which is only a reasonable choice for a short-lived run.
  rotate: true
  # Gzip rotated files (palworld-monitor.log.1.gz), true or false. With false
  # they stay plain text.
  compress: true
  # Delete rotated files whose last write is older than this many days
  # (0-3650). 0 = keep every rotated file the backupCount allows. Old files are
  # swept at startup, after each rotation, and hourly in between.
  retentionDays: 30

# Log level is set with the LOG_LEVEL environment variable (DEBUG, INFO,
# WARNING, ERROR); the default is INFO. The console gets the same log records
# as the file.
